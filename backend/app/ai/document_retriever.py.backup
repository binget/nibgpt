import re
from collections import Counter


STOP_WORDS = {
    "a", "an", "and", "are", "as", "at",
    "be", "by", "for", "from", "has", "have",
    "in", "is", "it", "of", "on", "or",
    "that", "the", "this", "to", "was",
    "what", "when", "where", "which", "who",
    "with", "does", "do", "about", "say",
}


def tokenize(text: str) -> list[str]:

    words = re.findall(
        r"[a-zA-Z0-9]+",
        (text or "").lower(),
    )

    return [
        word
        for word in words
        if (
            len(word) > 2
            and word not in STOP_WORDS
        )
    ]


def chunk_pages(
    pages: list[dict],
    chunk_size: int = 1800,
    overlap: int = 250,
) -> list[dict]:

    chunks = []

    for page in pages:

        page_number = page.get(
            "page_number"
        )

        text = (
            page.get("text")
            or ""
        ).strip()

        if not text:
            continue

        start = 0
        chunk_no = 1

        while start < len(text):

            end = min(
                start + chunk_size,
                len(text),
            )

            content = (
                text[start:end]
                .strip()
            )

            if content:

                chunks.append(
                    {
                        "page_number":
                            page_number,

                        "chunk_no":
                            chunk_no,

                        "content":
                            content,
                    }
                )

                chunk_no += 1

            if end >= len(text):
                break

            start = max(
                end - overlap,
                start + 1,
            )

    return chunks


def score_chunk(
    question: str,
    content: str,
) -> float:

    question_tokens = tokenize(
        question
    )

    content_tokens = tokenize(
        content
    )

    if (
        not question_tokens
        or not content_tokens
    ):
        return 0.0

    content_counts = Counter(
        content_tokens
    )

    score = 0.0

    for token in set(
        question_tokens
    ):

        count = content_counts.get(
            token,
            0,
        )

        if count:
            score += (
                1.0
                + min(count, 5) * 0.20
            )

    # Give extra weight to exact
    # multi-word phrases.
    question_clean = " ".join(
        question_tokens
    )

    content_clean = " ".join(
        content_tokens
    )

    if (
        len(question_clean) > 5
        and question_clean
        in content_clean
    ):
        score += 5.0

    return score


def retrieve_relevant_chunks(
    question: str,
    pages: list[dict],
    limit: int = 8,
) -> list[dict]:

    chunks = chunk_pages(
        pages
    )

    scored = []

    for chunk in chunks:

        score = score_chunk(
            question,
            chunk["content"],
        )

        if score <= 0:
            continue

        scored.append(
            {
                **chunk,
                "score":
                    round(score, 3),
            }
        )

    scored.sort(
        key=lambda item:
            item["score"],
        reverse=True,
    )

    return scored[:limit]